# Server Configuration
PORT=3457
HOST=0.0.0.0

# Path to cc-haha binary or entrypoint
CLAUDE_HAHA_PATH=/tmp/cc-haha/src/entrypoints/cli.tsx

# Pairing Configuration
PAIRING_CODE_EXPIRY_MINUTES=5
JWT_SECRET=change-me-to-a-random-secret-string

# Session Limits
MAX_SESSIONS=5

# Discovery Service
DISCOVERY_ENABLED=true
DISCOVERY_PORT=3458
DISCOVERY_INTERVAL_SECONDS=10

# Logging
LOG_LEVEL=info
